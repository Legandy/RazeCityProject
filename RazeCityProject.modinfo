<?xml version="1.0" encoding="utf-8"?>
<Mod id="b36b03a0-ddec-441e-9908-af4609d66647" version="1.1">
	<!--
	  * @file RazeCityProject.modinfo
	  * @brief Mod configuration manifest managing asset loading, game database additions, and text injection actions.
	  * @author Legandy
	  -->
	<Properties>
		<Name>LOC_LGY_RAZE_CITY_PROJECT_MOD_NAME</Name>
		<Teaser>LOC_LGY_RAZE_CITY_PROJECT_MOD_TEASER</Teaser>
		<Description>LOC_LGY_RAZE_CITY_PROJECT_DESCRIPTION</Description>
		<Authors>Legandy</Authors>
		<AffectsSavedGames>1</AffectsSavedGames>
		<CompatibleVersions>1.2,2.0</CompatibleVersions>
	</Properties>

		<LocalizedText>
		<Text id="LOC_LGY_RAZE_CITY_PROJECT_MOD_NAME">
			<en_US>Raze City Project</en_US>
			<de_DE>Stadtabriss Projekt</de_DE>
		</Text>
		<Text id="LOC_LGY_RAZE_CITY_PROJECT_MOD_TEASER">
			<en_US>Adds an Abandon/Raze City Project to each owned city.</en_US>
			<de_DE>Fügt ein Stadt Aufgeben/Abriss Projekt zu jeder Stadt in Besitz hinzu.</de_DE>
		</Text>
		<Text id="LOC_LGY_RAZE_CITY_PROJECT_DESCRIPTION">
			<en_US>Adds an Abandon/Raze City Project to each owned city.[NEWLINE][NEWLINE]Abandon City Project:[NEWLINE]The owned city will be converted to a Free City.[NEWLINE][NEWLINE]Raze City Project:[NEWLINE]The owned city will be razed and converted into a Settler.</en_US>
			<de_DE>Fügt ein Stadtaufgabe/Stadtabriss Projekt zu jeder Stadt in Besitz hinzu.[NEWLINE][NEWLINE]Stadtaufgabe Projekt:[NEWLINE]Die eigene Stadt wird in eine freie Stadt umgewandelt.[NEWLINE][NEWLINE]Stadtabriss Projekt:[NEWLINE]Reißt die eigene Stadt nieder und wandelt die Stadt in einen Siedler um.</de_DE>
		</Text>
	</LocalizedText>
	
	<InGameActions>
		<!-- Core Gameplay Definitions -->
		<UpdateDatabase id="Gameplay">
			<File>Core/RazeCityProject.sql</File>
		</UpdateDatabase>
		
		<!-- Split Language Text Files -->
		<UpdateText id="Localization">
			<File>Text/RazeCityProject_en_US.sql</File>
			<File>Text/RazeCityProject_de_DE.sql</File>
		</UpdateText>

		<!-- Front-Facing Graphic Icons -->
		<UpdateIcons id="Icons">
			<File>Icons/RazeCityProject_Icons.xml</File>
		</UpdateIcons>
		
		<!-- Engine Logic Scripts -->
		<AddGameplayScripts id="Lua">
			<File>Scripts/RazeCityProject_Gameplay.lua</File>
		</AddGameplayScripts>
	</InGameActions>
	
	<Files>
		<File>Core/RazeCityProject.sql</File>
		<File>Scripts/RazeCityProject_Gameplay.lua</File>
		<File>Icons/RazeCityProject_Icons.xml</File>
		<File>Text/RazeCityProject_en_US.sql</File>
		<File>Text/RazeCityProject_de_DE.sql</File>
	</Files>
</Mod>